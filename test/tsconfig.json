{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["../test/**/*.ts", "../testing/**/*.ts", "../store/**/*.ts"]
}
